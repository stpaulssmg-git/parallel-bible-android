        <item name="colorPrimary">#000000</item>
        <item name="colorPrimaryDark">#121212</item>
        <item name="colorSecondary">#8C1D1A</item>

        <!-- Material3 Surface & Background Roles -->
        <item name="colorSurface">#FFFFFF</item>
